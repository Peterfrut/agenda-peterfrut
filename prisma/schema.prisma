generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id                String   @id @default(cuid())

  roomId            String
  roomName          String

  title             String
  date              String
  startTime         String
  endTime           String

  userName          String
  userEmail         String
  participantsEmails String?
  longReason        String?

  status            String   @default("confirmed")
  reminderSent      Boolean  @default(false)

  // === novos campos para import/sync ===
  provider          String   @default("local") // local | ics | google
  externalId        String?  // UID#RECURRENCE-ID ou UID#DTSTART
  externalSource    String?  // X-WR-CALNAME (opcional)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  changeRequests    BookingChangeRequest[]

  @@index([roomId, date])
  @@unique([provider, roomId, externalId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  verified  Boolean  @default(false)
  active    Boolean  @default(true)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailVerifiedAt DateTime?
  role      String   @default("user") // user | admin
  lastSeenReleaseAt DateTime?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  bookingChangeRequests BookingChangeRequest[]
  notifications Notification[]
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  category    String
  severity    String   @default("info")

  actorId     String?
  actorName   String?
  actorEmail  String?

  targetType  String?
  targetId    String?
  targetLabel String?

  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
  @@index([targetType, createdAt])
}

model BookingChangeRequest {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterEmail String
  type           String
  requestedDate  String?
  requestedStartTime String?
  requestedEndTime String?
  description    String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resolvedAt     DateTime?

  @@index([bookingId])
  @@index([requesterId, createdAt])
  @@index([requesterEmail, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  

  @@index([userId])
  @@index([expiresAt])
}

model Holiday {
  id        String   @id @default(cuid())
  roomId    String?  // null = feriado global (todas as salas)
  name      String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([roomId, date])
  @@index([date])
}
